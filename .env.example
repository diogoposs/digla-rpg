# Copie para .env (ignorado no Git) somente para testes locais com PostgreSQL.
# Obtenha a URL em Neon > Connect, com Connection pooling ativado.
# Preencha a conexão real apenas em .env ou em Render > Environment.
DATABASE_URL=

# Opcional: origem pública de um domínio próprio. Na Render é detectada automaticamente.
PUBLIC_ORIGIN=
